# Build context Docker = root repo. Kecualikan semua yang tidak perlu / sensitif.

# VCS & IDE
.git
.gitignore
.vs
.vscode
.idea
.agents

# Build output .NET
**/bin
**/obj
**/App_Data

# Hanya Maya.Server + Maya.Shared yang masuk image (Agent berjalan di laptop)
Maya.Agent

