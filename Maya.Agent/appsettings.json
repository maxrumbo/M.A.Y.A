{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ServerHubUrl": "http://localhost:5063/hubs/maya",
  "DeviceId": "maxwell-laptop",
  "Maya": {
    "DryRunPower": true
  },
  "WakeWord": {
    "ConfidenceThreshold": 0.80,
    "CooldownSeconds": 5,
    "FindMeCooldownSeconds": 10
  },
  "FindMe": {
    "DefaultDurationSeconds": 10,
    "MaxDurationSeconds": 30,
    "MinVolumePercent": 80,
    "DefaultMessage": "Aku di sini, Max!"
  },
  "AppAllowlist": {
    "notepad": "notepad.exe",
    "antigravity": "antigravity",
    "vscode": "code",
    "vs": "devenv",
    "brave": "brave",
    "chrome": "chrome",
    "terminal": "wt.exe",
    "spotify": "spotify",
    "explorer": "explorer.exe"
  }
}
